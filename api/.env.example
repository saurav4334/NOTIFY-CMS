# =============================================================================
# Notify — lead endpoint configuration
# =============================================================================
# Copy this file to api/.env ON THE SERVER and fill in the real values:
#
#   cp api/.env.example api/.env
#   chmod 600 api/.env
#
# api/.env is in .gitignore, is NEVER committed, and is PRESERVED across cPanel
# deployments (.cpanel.yml copies the existing one back). Never commit real
# credentials — this example must stay blank where a secret belongs.
# =============================================================================

# ── SMTP (used by api/contact.php — authenticated send, no PHP mail()) ───────
SMTP_HOST=mail.notifybd.com
SMTP_PORT=465
SMTP_USERNAME=sales@notifybd.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=ssl          # ssl for port 465, tls for port 587

# ── Recipient / sender ───────────────────────────────────────────────────────
LEAD_TO_EMAIL=sales@notifybd.com
LEAD_FROM_EMAIL=sales@notifybd.com
LEAD_FROM_NAME="Notify Website"

# (Legacy, used by api/lead.php only — safe to leave as-is.)
LEAD_SUBJECT=New enquiry from notifybd.com

# ── Private lead storage ─────────────────────────────────────────────────────
# STRONGLY RECOMMENDED: point this OUTSIDE public_html so leads can never be
# fetched over HTTP. Create it first:
#
#   mkdir -p /home/urbaneas/notify-storage
#   chmod 750 /home/urbaneas/notify-storage
#
# Then set:
#   LEAD_STORAGE_PATH=/home/urbaneas/notify-storage
#
# If left empty, the endpoint falls back to api/storage/ inside the document
# root, which is blocked by api/.htaccess and the root .htaccess — but keeping
# customer data outside the web root is safer.
LEAD_STORAGE_PATH=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to POST. Anything else is rejected with 403.
ALLOWED_ORIGINS=https://notifybd.com,https://www.notifybd.com

# ── Rate limiting (per IP address) ───────────────────────────────────────────
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=3600
