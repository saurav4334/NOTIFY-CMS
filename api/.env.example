# =============================================================================
# NotifyBD — lead endpoint configuration
# =============================================================================
# Copy this file to api/.env ON THE SERVER and fill in the real values.
#
#   cp api/.env.example api/.env
#   chmod 600 api/.env
#
# api/.env is in .gitignore and is NEVER committed, never built into dist/, and
# never copied by the cPanel deployment (which preserves the existing one).
# =============================================================================

# ── Where lead notifications are emailed ─────────────────────────────────────
# Leave LEAD_TO_EMAIL empty and leads will still be STORED, just not emailed.
LEAD_TO_EMAIL=
# The envelope From. Use an address on your own domain or the host's mail
# server will likely reject the message (SPF/DMARC).
LEAD_FROM_EMAIL=no-reply@notifybd.com
LEAD_SUBJECT=New enquiry from notifybd.com

# ── Private lead storage ─────────────────────────────────────────────────────
# STRONGLY RECOMMENDED: point this OUTSIDE public_html so leads can never be
# fetched over HTTP. Create it first:
#
#   mkdir -p /home/CPANELUSER/notifybd-storage
#   chmod 750 /home/CPANELUSER/notifybd-storage
#
# LEAD_STORAGE_PATH=/home/CPANELUSER/notifybd-storage
#
# If left empty, the endpoint falls back to api/storage/ inside the document
# root, which is blocked by api/.htaccess and the root .htaccess — but keeping
# customer data outside the web root is safer.
LEAD_STORAGE_PATH=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to POST to this endpoint.
# Requests from anywhere else are rejected with 403.
ALLOWED_ORIGINS=https://notifybd.com,https://www.notifybd.com

# ── Rate limiting (per IP address) ───────────────────────────────────────────
# Maximum submissions per window, and the window length in seconds.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=3600
