# =============================================================================
# NotifyBD — Apache configuration for cPanel shared hosting
# =============================================================================
# Design rules:
#   * Every directive that can be unavailable is wrapped in <IfModule>, so a
#     strict host cannot turn this file into a blanket HTTP 500.
#   * Apache 2.4 authorisation syntax (Require) with a 2.2 fallback.
#   * No .html rewriting: clean URLs come from real directories
#     (/pricing/ -> /pricing/index.html), so mod_dir does the work.
#   * 404s return a real 404 page with a real 404 status.
#   * No SPA fallback, no PHP handler changes, no legacy directives.
# =============================================================================

# ── Default document ─────────────────────────────────────────────────────────
DirectoryIndex index.html index.php

# ── Directory listing off ────────────────────────────────────────────────────
# Guarded: on hosts where AllowOverride does not permit Options, an unguarded
# `Options -Indexes` is a 500.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# ── Custom error page ────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── HTTPS + canonical host ───────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS.
  #    The X-Forwarded-Proto check prevents an infinite redirect loop on hosts
  #    that terminate TLS at a proxy/CDN and pass plain HTTP to Apache.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # 2. Redirect www → non-www (runs after HTTPS, so at most one extra hop).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

</IfModule>

# mod_dir appends the trailing slash for directory URLs (/pricing → /pricing/),
# which is what keeps our canonical trailing-slash URLs consistent.
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# ── Compression ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  # woff2 is already compressed — do not waste CPU re-compressing it.
</IfModule>

# ── Browser caching ──────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML must stay fresh: a deploy has to be visible immediately.
  ExpiresByType text/html                "access plus 0 seconds"

  # CSS/JS are not content-hashed yet, so cache for a week, not a year.
  # (Bump to 1 year once assets are fingerprinted — see DEPLOYMENT.md.)
  ExpiresByType text/css                 "access plus 1 week"
  ExpiresByType text/javascript          "access plus 1 week"
  ExpiresByType application/javascript   "access plus 1 week"

  # Fonts and images are immutable in practice.
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 month"
  ExpiresByType image/webp               "access plus 1 month"
  ExpiresByType image/avif               "access plus 1 month"
  ExpiresByType image/png                "access plus 1 month"
  ExpiresByType image/jpeg               "access plus 1 month"
  ExpiresByType image/x-icon             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # ── Security headers ───────────────────────────────────────────────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # X-XSS-Protection is deprecated and can itself introduce vulnerabilities;
  # 0 explicitly disables the legacy XSS auditor (deprecated; can add risk).
  Header always set X-XSS-Protection "0"

  # Content-Security-Policy. This is only possible because the site has no CDN
  # dependencies at all: styles, scripts, fonts and icons are all same-origin.
  # 'unsafe-inline' is required for style-src ONLY because the design uses
  # inline style="" attributes on gradients.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.facebook.com https://connect.facebook.net; font-src 'self'; connect-src 'self' https://www.facebook.com https://connect.facebook.net; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # HSTS — enable only once HTTPS is confirmed working on the live domain.
  # Uncommenting this before TLS is stable will lock users out.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Immutable caching for the font (its name never changes content).
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Protect sensitive files ──────────────────────────────────────────────────
# .env, logs, backups, archives, config and version-control leftovers.
<FilesMatch "(^\.env|^\.env\..*|\.(env|ini|log|sh|sql|bak|old|orig|swp|tar|gz|zip|yml|yaml|json5|lock)$|^\.git|^\.htaccess$|^\.htpasswd$|^composer\.|^package.*\.json$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# manifest.webmanifest must stay reachable despite the .json-ish rule above.
<Files "manifest.webmanifest">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Allow from all
  </IfModule>
</Files>

# Block the lead API's private storage directory outright, in case the host's
# document root is configured such that api/storage/ is web-reachable.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/storage/ - [F,L]
  RewriteRule ^api/logs/ - [F,L]
</IfModule>

# ── Correct MIME types ───────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>
